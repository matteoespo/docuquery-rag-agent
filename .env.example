# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=docuquery-rag-agent

# Security
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret

# CORS
# Comma-separated list of allowed frontend origins. Never use "*" in production.
CORS_ORIGINS=http://localhost:8501,http://web:8501

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b
VISION_MODEL=moondream
EMBEDDING_MODEL=nomic-embed-text

# Paths
DB_DIR=data/chroma_db
MANUAL_PATH=data/pdfs/

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_FILES=10

# Ingestion tuning
# Set to true to skip Moondream image captioning entirely (faster re-ingestion)
SKIP_IMAGE_CAPTIONING=false
# Images smaller than this (bytes) are skipped for captioning
MIN_IMAGE_BYTES=5000
# Images where both dimensions are below this (px) are skipped
MIN_IMAGE_DIMENSION=100
# Max concurrent Moondream calls (keep low for single-GPU setups)
MAX_VISION_WORKERS=2
# Max PDFs processed in parallel
MAX_PDF_WORKERS=4
# Chunks per Chroma write batch
CHROMA_BATCH_SIZE=100

# Retrieval
RETRIEVAL_K=3
MAX_RETRIES=2
