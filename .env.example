# ── LangSmith ──
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=docuquery-rag-agent

# ── Authentication ──
SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=30

# ── Database ──
DATABASE_URL=sqlite:///data/db/app.db

# ── Ingestion tuning ──
# Set to true to skip Moondream image captioning entirely (faster re-ingestion)
SKIP_IMAGE_CAPTIONING=false
# Images smaller than this (bytes) are skipped for captioning
MIN_IMAGE_BYTES=5000
# Images where both dimensions are below this (px) are skipped
MIN_IMAGE_DIMENSION=100
# Max concurrent Moondream calls (keep low for single-GPU setups)
MAX_VISION_WORKERS=2
# Max PDFs processed in parallel
MAX_PDF_WORKERS=4
# Chunks per Chroma write batch
CHROMA_BATCH_SIZE=100
