# LangSmith (optional, off by default)
# Tracing sends every prompt, retrieved document chunk and answer to LangSmith's
# servers. Set to true only if you want that; the Analytics page needs it.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=docuquery-rag-agent

# CORS
# Comma-separated list of allowed frontend origins. Never use "*" in production.
CORS_ORIGINS=http://localhost:3000,http://web:3000

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
# phi4-mini (3.8B, ~2.5 GB) scored best on the evals among models that fit a 4 GB GPU
LLM_MODEL=phi4-mini
VISION_MODEL=moondream
EMBEDDING_MODEL=nomic-embed-text

# Paths
DB_DIR=data/chroma_db
MANUAL_PATH=data/pdfs/

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_FILES=10

# Ingestion tuning
# Set to true to skip Moondream image captioning entirely (faster re-ingestion)
SKIP_IMAGE_CAPTIONING=false
# Images smaller than this (bytes) are skipped for captioning
MIN_IMAGE_BYTES=5000
# Images where both dimensions are below this (px) are skipped
MIN_IMAGE_DIMENSION=100
# Chunks per Chroma write batch
CHROMA_BATCH_SIZE=100

# Retrieval
RETRIEVAL_K=5
# Best-chunk relevance (0..1) below which the agent falls back to web search
MIN_RELEVANCE=0.43
# Extra LLM call that checks the answer and can retry with web search (off: no accuracy gain in evals)
ENABLE_ANSWER_GRADER=false
MAX_RETRIES=2
